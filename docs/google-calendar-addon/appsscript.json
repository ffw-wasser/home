    "https://www.googleapis.com/auth/calendar.events",
    "https://www.googleapis.com/auth/script.external_request"
  ],
  "urlFetchWhitelist": ["https://www.googleapis.com/calendar/v3/"],
  "addOns": {
    "common": {
      "name": "H₂O Kalenderauswahl",
      "logoUrl": "https://ffw-wasser.github.io/home/assets/branding/ffw-home-192.png",
