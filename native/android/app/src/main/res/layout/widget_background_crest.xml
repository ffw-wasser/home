<?xml version="1.0" encoding="utf-8"?>
<!-- Decorative background only: no layout column and no click/accessibility target.
     fitEnd preserves the original square asset and anchors it to the right. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_background_crest"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:alpha="0.25"
    android:visibility="gone"
    android:clickable="false"
    android:focusable="false"
    android:contentDescription="@null"
    android:importantForAccessibility="no">
    <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
        android:padding="3dp" android:scaleType="fitEnd"
        android:src="@drawable/widget_crest_artwork"
        android:contentDescription="@null" android:importantForAccessibility="no" />
    <ImageView android:id="@+id/widget_crest_border"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:padding="3dp" android:scaleType="fitEnd"
        android:src="@drawable/widget_crest_border"
        android:contentDescription="@null" android:importantForAccessibility="no" />
    <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
        android:src="@drawable/widget_crest_scrim" android:scaleType="fitXY"
        android:contentDescription="@null" android:importantForAccessibility="no" />
</FrameLayout>
