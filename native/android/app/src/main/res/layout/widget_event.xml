<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="14dp" android:background="@drawable/widget_background">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
  <ImageView android:layout_width="26dp" android:layout_height="26dp" android:src="@mipmap/ic_launcher" android:contentDescription="H₂O Portal"/>
  <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:paddingStart="8dp" android:text="Feuerwehr Wasser" android:textSize="12sp" android:textStyle="bold" android:textColor="#34465B" android:maxLines="1" android:ellipsize="end"/>
 </LinearLayout>
 <TextView android:id="@+id/widget_day" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="#8A243C" android:textSize="20sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end"/>
 <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#172A40" android:textSize="16sp" android:textStyle="bold" android:maxLines="2" android:ellipsize="end"/>
 <TextView android:id="@+id/widget_time" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#172A40" android:textSize="14sp" android:maxLines="1"/>
 <TextView android:id="@+id/widget_location" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#34465B" android:textSize="14sp" android:maxLines="1" android:ellipsize="end"/>
 <TextView android:id="@+id/widget_clothing" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#34465B" android:textSize="13sp" android:maxLines="1" android:ellipsize="end"/>
 <TextView android:id="@+id/widget_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textSize="12sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end"/>
 <TextView android:id="@+id/widget_note" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#5B6571" android:textSize="11sp" android:maxLines="1" android:ellipsize="end"/>
</LinearLayout>