<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@drawable/widget_background" android:clipToOutline="true">
 <ImageView android:contentDescription="@null" android:importantForAccessibility="no" android:layout_width="match_parent" android:layout_height="3dp" android:background="#B62435"/>
 <LinearLayout android:id="@+id/widget_body" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:paddingHorizontal="10dp" android:paddingTop="5dp" android:paddingBottom="3dp" android:orientation="vertical">
  <LinearLayout android:id="@+id/widget_brand" android:layout_width="match_parent" android:layout_height="14dp" android:gravity="center_vertical">
   <ImageView android:layout_width="13dp" android:layout_height="13dp" android:src="@mipmap/ic_launcher" android:contentDescription="@null"/>
   <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="5dp" android:text="H₂O · Feuerwehr Wasser" android:textSize="10sp" android:textColor="#C0C8D3" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false"/>
  </LinearLayout>
  <LinearLayout android:id="@+id/widget_date" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
<TextView android:id="@+id/widget_day" android:text="Morgen" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#F7F8FA" android:textSize="24sp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:textStyle="bold"/>
  </LinearLayout>
<TextView android:id="@+id/widget_weekday" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#F7F8FA" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:visibility="gone"/><TextView android:id="@+id/widget_month" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#F7F8FA" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:visibility="gone"/>
  <ImageView android:id="@+id/widget_separator" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" android:contentDescription="@null"/>
<TextView android:id="@+id/widget_title" android:text="Terminthema" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#F7F8FA" android:textSize="17sp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:textStyle="bold"/><TextView android:id="@+id/widget_location" android:text="19:30 · Gerätehaus" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#C0C8D3" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" /><TextView android:id="@+id/widget_clothing" android:text="Einsatzkleidung" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#C0C8D3" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" /><TextView android:id="@+id/widget_hint" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#C0C8D3" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" />
  <LinearLayout android:id="@+id/widget_following" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:gravity="bottom" android:visibility="gone">
 <TextView android:id="@+id/widget_following_one" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textSize="12sp" android:textColor="#C0C8D3" android:maxLines="2" android:ellipsize="end" android:includeFontPadding="false"/>
 <TextView android:id="@+id/widget_following_two" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textSize="12sp" android:textColor="#C0C8D3" android:maxLines="2" android:ellipsize="end" android:includeFontPadding="false"/>
 </LinearLayout>
 </LinearLayout>
 <LinearLayout android:id="@+id/widget_footer" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="32dp" android:paddingHorizontal="10dp" android:gravity="center_vertical">
  <ImageView android:id="@+id/widget_status_icon" android:layout_width="16dp" android:layout_height="16dp" android:contentDescription="@null"/>
  <TextView android:id="@+id/widget_status" android:text="Rückmeldung offen" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="5dp" android:textSize="12sp" android:textColor="#FFFFFF" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false"/>
  <TextView android:id="@+id/widget_note" android:layout_width="14dp" android:layout_height="wrap_content" android:text="!" android:textColor="#E6BF74" android:gravity="center" android:visibility="gone"/>
  <TextView android:id="@+id/widget_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#C0C8D3" android:textSize="11sp" android:maxLines="1" android:includeFontPadding="false"/>
  <TextView android:id="@+id/widget_edit" android:layout_width="70dp" android:layout_height="44dp" android:text="Ändern" android:gravity="center" android:textColor="#FFFFFF" android:textSize="12sp" android:visibility="gone"/>
 </LinearLayout>
 <LinearLayout android:id="@+id/widget_actions" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginHorizontal="8dp" android:layout_marginBottom="6dp" android:orientation="horizontal" android:visibility="gone">
<TextView android:id="@+id/widget_reply_yes" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_marginHorizontal="2dp" android:background="#355E44" android:gravity="center" android:text="✓ Dabei" android:textColor="#FFFFFF" android:textSize="11sp" android:maxLines="1" android:includeFontPadding="false"/><TextView android:id="@+id/widget_reply_excused" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_marginHorizontal="2dp" android:background="#78303D" android:gravity="center" android:text="× Entschuldigt" android:textColor="#FFFFFF" android:textSize="11sp" android:maxLines="1" android:includeFontPadding="false"/><TextView android:id="@+id/widget_reply_maybe" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_marginHorizontal="2dp" android:background="#805B24" android:gravity="center" android:text="Unsicher" android:textColor="#FFFFFF" android:textSize="11sp" android:maxLines="1" android:includeFontPadding="false"/></LinearLayout></LinearLayout>