<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_background" android:clipToOutline="true">
    <ImageView android:id="@+id/widget_logo" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="top|end" android:layout_marginTop="18dp" android:layout_marginEnd="12dp" android:src="@drawable/widget_logo" android:alpha="0.12" android:scaleType="fitCenter" android:visibility="gone" android:contentDescription="@null" android:importantForAccessibility="no" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:clipToOutline="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:paddingHorizontal="12dp" android:paddingTop="7dp" android:paddingBottom="8dp">
            <TextView android:id="@+id/widget_brand" android:layout_width="match_parent" android:layout_height="16dp" android:includeFontPadding="false" android:textColor="#F5F5F6" android:text="H₂O · Feuerwehr Wasser" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" android:layout_marginBottom="4dp" />
            <LinearLayout android:id="@+id/widget_body" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
                <LinearLayout android:id="@+id/widget_date" android:layout_width="72dp" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:background="@drawable/widget_calendar_paper" android:clipToOutline="true">
                    <LinearLayout android:id="@+id/widget_bindings" android:layout_width="match_parent" android:layout_height="6dp" android:orientation="horizontal" android:gravity="center" android:paddingHorizontal="10dp">
                        <ImageView android:layout_width="3dp" android:layout_height="5dp" android:background="@drawable/widget_binding" android:contentDescription="@null" />
                        <ImageView android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                        <ImageView android:layout_width="3dp" android:layout_height="5dp" android:background="@drawable/widget_binding" android:contentDescription="@null" />
                    </LinearLayout>
                    <TextView android:id="@+id/widget_month" android:layout_width="match_parent" android:layout_height="wrap_content" android:includeFontPadding="false" android:textSize="9sp" android:textStyle="bold" android:textColor="#FFFFFF" android:background="@drawable/widget_calendar_header" android:gravity="center" android:maxLines="1" android:paddingTop="3dp" android:paddingBottom="1dp" />
                    <TextView android:id="@+id/widget_day" android:layout_width="match_parent" android:layout_height="wrap_content" android:includeFontPadding="false" android:textSize="24sp" android:textStyle="bold" android:textColor="#191B20" android:gravity="center" android:maxLines="1" />
                    <ImageView android:id="@+id/widget_date_line" android:layout_width="match_parent" android:layout_height="0.5dp" android:layout_marginHorizontal="8dp" android:background="#A6A52332" android:contentDescription="@null" />
                    <TextView android:id="@+id/widget_weekday" android:textStyle="bold" android:layout_width="match_parent" android:layout_height="wrap_content" android:includeFontPadding="false" android:textSize="8sp" android:textColor="#191B20" android:gravity="center" android:paddingBottom="2dp" android:maxLines="1" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:orientation="vertical" android:id="@+id/widget_details">
                    <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:includeFontPadding="false" android:textColor="#F5F5F6" android:textSize="15sp" android:textStyle="bold" android:maxLines="2" android:ellipsize="end" />
                    <TextView android:id="@+id/widget_location" android:layout_width="match_parent" android:layout_height="wrap_content" android:includeFontPadding="false" android:layout_marginTop="1dp" android:textColor="@color/widget_secondary" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" android:drawableStart="@drawable/widget_clock" android:drawablePadding="3dp" android:textStyle="bold" />
                    <TextView android:id="@+id/widget_clothing" android:layout_width="match_parent" android:layout_height="wrap_content" android:includeFontPadding="false" android:layout_marginTop="1dp" android:textColor="@color/widget_secondary" android:textSize="9sp" android:maxLines="1" android:ellipsize="end" android:drawableStart="@drawable/widget_clothing" android:drawablePadding="3dp" android:textStyle="bold" />
                    <TextView android:id="@+id/widget_hint" android:layout_width="match_parent" android:layout_height="wrap_content" android:includeFontPadding="false" android:textColor="#F5F5F6" android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>
            <ImageView android:layout_width="match_parent" android:layout_height="0.5dp" android:background="#686B72" android:contentDescription="@null" />
            <LinearLayout android:id="@+id/widget_reply_section" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView android:id="@+id/widget_reply_caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:includeFontPadding="false" android:textColor="#F5F5F6" android:text="Deine Rückmeldung" android:textSize="11sp" android:textStyle="bold" android:layout_marginTop="4dp" android:visibility="gone" />
                <LinearLayout android:id="@+id/widget_actions" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="4dp" android:orientation="horizontal" android:background="@drawable/widget_selector_background" android:clipToOutline="true" android:visibility="gone">
                    <TextView android:id="@+id/widget_reply_yes" android:layout_width="0dp" android:layout_height="match_parent" android:includeFontPadding="false" android:textColor="#F5F5F6" android:layout_weight="1" android:text="○ Dabei" android:gravity="center" android:textSize="13sp" android:paddingHorizontal="2dp" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp" android:autoSizeMaxTextSize="13sp" android:autoSizeStepGranularity="1sp" android:layout_marginHorizontal="1dp" android:textStyle="bold" />
                    <TextView android:id="@+id/widget_reply_excused" android:layout_width="0dp" android:layout_height="match_parent" android:includeFontPadding="false" android:textColor="#F5F5F6" android:layout_weight="1" android:text="○ Entschuldigt" android:gravity="center" android:textSize="13sp" android:paddingHorizontal="2dp" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp" android:autoSizeMaxTextSize="13sp" android:autoSizeStepGranularity="1sp" android:layout_marginHorizontal="1dp" android:textStyle="bold" />
                    <TextView android:id="@+id/widget_reply_maybe" android:layout_width="0dp" android:layout_height="match_parent" android:includeFontPadding="false" android:textColor="#F5F5F6" android:layout_weight="1" android:text="○ Unsicher" android:gravity="center" android:textSize="13sp" android:paddingHorizontal="2dp" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp" android:autoSizeMaxTextSize="13sp" android:autoSizeStepGranularity="1sp" android:layout_marginHorizontal="1dp" android:textStyle="bold" />
                </LinearLayout>
                <TextView android:id="@+id/widget_retry" android:layout_width="match_parent" android:layout_height="44dp" android:includeFontPadding="false" android:textColor="#F5F5F6" android:text="Erneut versuchen" android:textSize="12sp" android:textStyle="bold" android:gravity="center" android:layout_marginTop="4dp" android:background="@drawable/widget_panel_background" android:visibility="gone" />
                <ImageView android:id="@+id/widget_status_line" android:layout_width="match_parent" android:layout_height="3dp" android:layout_marginTop="3dp" android:layout_marginBottom="1dp" android:contentDescription="@null" android:scaleType="fitXY" />
                <LinearLayout android:id="@+id/widget_footer" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="12dp" android:layout_marginTop="2dp" android:gravity="center_vertical" android:orientation="horizontal">
                    <ImageView android:id="@+id/widget_status_icon" android:layout_width="12dp" android:layout_height="12dp" android:visibility="gone" android:contentDescription="@null" android:layout_marginEnd="4dp" />
                    <TextView android:id="@+id/widget_status" android:layout_width="0dp" android:layout_height="wrap_content" android:includeFontPadding="false" android:textColor="#F5F5F6" android:layout_weight="1" android:textSize="9sp" android:maxLines="3" android:ellipsize="end" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="7sp" android:autoSizeMaxTextSize="11sp" android:autoSizeStepGranularity="1sp" android:textStyle="bold" />
                    <TextView android:id="@+id/widget_note" android:layout_width="10dp" android:layout_height="wrap_content" android:includeFontPadding="false" android:text="!" android:textColor="#D8AC67" android:textSize="9sp" android:gravity="center" android:visibility="gone" />
                    <TextView android:id="@+id/widget_time" android:layout_width="match_parent" android:layout_height="wrap_content" android:includeFontPadding="false" android:textColor="@color/widget_secondary" android:visibility="gone" />
                    <TextView android:id="@+id/widget_edit" android:layout_width="match_parent" android:layout_height="wrap_content" android:includeFontPadding="false" android:textColor="#F5F5F6" android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:id="@+id/widget_following" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="8dp" android:orientation="vertical" android:visibility="gone">
                <TextView android:id="@+id/widget_following_label" android:layout_width="match_parent" android:layout_height="18dp" android:includeFontPadding="false" android:text="Weitere Termine" android:textColor="#B9BCC3" android:textSize="10sp" />
                <TextView android:id="@+id/widget_following_one" android:layout_width="match_parent" android:layout_height="0dp" android:includeFontPadding="false" android:layout_weight="1" android:paddingVertical="2dp" android:gravity="center_vertical" android:textColor="#C8CBD1" android:textSize="12sp" android:maxLines="2" android:ellipsize="end" />
                <ImageView android:layout_width="match_parent" android:layout_height="0.5dp" android:background="#45484F" android:contentDescription="@null" />
                <TextView android:id="@+id/widget_following_two" android:layout_width="match_parent" android:layout_height="0dp" android:includeFontPadding="false" android:layout_weight="1" android:paddingVertical="2dp" android:gravity="center_vertical" android:textColor="#C8CBD1" android:textSize="12sp" android:maxLines="2" android:ellipsize="end" />
                <ImageView android:layout_width="match_parent" android:layout_height="0.5dp" android:background="#45484F" android:contentDescription="@null" />
            </LinearLayout>
            <TextView android:id="@+id/widget_separator" android:layout_width="match_parent" android:layout_height="wrap_content" android:includeFontPadding="false" android:textColor="#F5F5F6" android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
