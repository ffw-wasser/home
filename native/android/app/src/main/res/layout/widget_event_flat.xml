<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@drawable/widget_background" android:clipToOutline="true">
<ImageView android:layout_width="match_parent" android:layout_height="3dp" android:background="#9E0A1F" android:contentDescription="@null" android:importantForAccessibility="no"/>
<LinearLayout android:id="@+id/widget_body" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:paddingHorizontal="6dp" android:paddingVertical="3dp" android:gravity="center_vertical" android:orientation="horizontal">
<LinearLayout android:id="@+id/widget_date" android:layout_width="68dp" android:layout_height="match_parent" android:gravity="center_vertical">
<TextView android:id="@+id/widget_day" android:singleLine="true" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="19sp" android:textColor="#192B40" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:textStyle="bold"/>
</LinearLayout>
<LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
<TextView android:id="@+id/widget_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#192B40" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:textStyle="bold"/>
<LinearLayout android:id="@+id/widget_footer" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
<ImageView android:id="@+id/widget_status_icon" android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/widget_status_yes" android:contentDescription="@null" android:importantForAccessibility="no"/>
<TextView android:id="@+id/widget_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="#192B40" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:layout_marginStart="3dp" android:layout_weight="1" android:textStyle="bold"/>
<TextView android:id="@+id/widget_note" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="10sp" android:textColor="#192B40" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:visibility="gone" android:text="!" android:layout_marginHorizontal="3dp"/>
<TextView android:id="@+id/widget_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="10sp" android:textColor="#192B40" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:layout_marginStart="4dp"/>
</LinearLayout>
</LinearLayout>
<TextView android:id="@+id/widget_brand" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="10sp" android:textColor="#192B40" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:visibility="gone"/><TextView android:id="@+id/widget_weekday" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="10sp" android:textColor="#192B40" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:visibility="gone"/><TextView android:id="@+id/widget_month" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="10sp" android:textColor="#192B40" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:visibility="gone"/><TextView android:id="@+id/widget_location" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="10sp" android:textColor="#192B40" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:visibility="gone"/><TextView android:id="@+id/widget_clothing" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="10sp" android:textColor="#192B40" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:visibility="gone"/><TextView android:id="@+id/widget_separator" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="10sp" android:textColor="#192B40" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:visibility="gone"/>
</LinearLayout>
</LinearLayout>
